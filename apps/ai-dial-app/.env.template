# Environment Variables Template
# Copy this file to .env.local and fill in your values

# NextAuth Configuration (Required)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl

# GitHub OAuth Provider (Optional)
# AUTH_GITHUB_CLIENT_ID=your-github-client-id
# AUTH_GITHUB_SECRET=your-github-client-secret

# Google OAuth Provider (Optional)
# AUTH_GOOGLE_CLIENT_ID=your-google-client-id
# AUTH_GOOGLE_SECRET=your-google-client-secret

# Azure AD Provider (Optional)
# AUTH_AZURE_AD_CLIENT_ID=your-azure-client-id
# AUTH_AZURE_AD_SECRET=your-azure-client-secret
# AUTH_AZURE_AD_TENANT_ID=your-azure-tenant-id

# Keycloak Provider (Optional)
# AUTH_KEYCLOAK_CLIENT_ID=your-keycloak-client-id
# AUTH_KEYCLOAK_SECRET=your-keycloak-client-secret
# AUTH_KEYCLOAK_ISSUER=https://your-keycloak-server/realms/your-realm

# API Configuration (Optional)
# API_URL=http://localhost:8080/api
